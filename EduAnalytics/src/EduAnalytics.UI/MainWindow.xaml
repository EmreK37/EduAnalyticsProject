<Window x:Class="EduAnalytics.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        xmlns:views="clr-namespace:EduAnalytics.UI.Views"
        Title="EduAnalytics — Eğitimde Veriye Dayalı Karar Destek Sistemi"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamAnalysisViewModel}">
            <views:ExamAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamCreateViewModel}">
            <views:ExamCreateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnswerEntryViewModel}">
            <views:AnswerEntryView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <StackPanel>
                <StackPanel Margin="20,24,20,32">
                    <TextBlock Text="📊 EduAnalytics"
                               Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Karar Destek Sistemi"
                               Foreground="#9CA3AF"
                               FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="🏠  Dashboard"
                        Command="{Binding NavigateToDashboardCommand}"
                        Style="{StaticResource SidebarButtonStyle}"/>

                <Button Content="📝  Yeni Sınav Oluştur"
                        Command="{Binding NavigateToCreateExamCommand}"
                        Style="{StaticResource SidebarButtonStyle}"/>

                <Separator Background="#374151" Margin="16,16" Height="1"/>

                <TextBlock Text="YAKLAŞAN SÜRÜMLER"
                           Foreground="#6B7280"
                           FontSize="10" FontWeight="Bold"
                           Margin="20,8,20,8"/>
                <TextBlock Text="👥  Öğrenci Yönetimi"
                           Foreground="#6B7280" FontSize="14"
                           Margin="20,4"/>
                <TextBlock Text="📄  Rapor Dışa Aktarma"
                           Foreground="#6B7280" FontSize="14"
                           Margin="20,4"/>
            </StackPanel>
        </Border>

        <!-- ANA İÇERİK -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="32,24"/>
    </Grid>
</Window>
